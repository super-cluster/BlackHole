rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // visits collection:
    // - Anyone can CREATE a new visit document (for tracking)
    // - Nobody can READ, UPDATE, or DELETE from the client
    //   (Admin dashboard reads via privileged SDK config — same project)
    match /visits/{visitId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
